+import { usePathname } from "next/navigation";
+
+/**
+ * Contrato RED ÔÇö TASK-015 (Patch v3, navega├º├úo em abas).
+ *
+ * Derivado de: spec.md P4 (CA-P3-05, CA-P3-06, CA-P3-07) + P3 (R8ÔÇôR10) +
+ * tasks.json TASK-015 acceptanceCriteria + plan.md
+ * (`isActive = pathname === item.href || pathname.startsWith(item.href + '/')`,
+ * estilo ativo `border-b-2 font-semibold` na cor do m├│dulo, D12 transversal).
+ *
+ * Este teste DEVE falhar antes da implementa├º├úo de Hefesto (RED): hoje o
+ * ModuleLayout n├úo marca aria-current nem estilo de aba ativa.
+ */
+
+// Padr├úo do repo (ver __tests__/app/pluto/months/page.test.tsx e
+// __tests__/app/dashboard/page.test.tsx): mock local sobrescreve o mock
+// global de __tests__/setup.ts e devolve o pathname por teste.
+vi.mock("next/navigation", () => ({
+  usePathname: vi.fn(),
+}));
+
+const mockUsePathname = usePathname as Mock;
+
+// navItems espelham components/milon/MilonLayout.tsx (TASK-014, D10)
+const milonNavItems = [
+  { href: "/milon/exercises", label: "Exerc├¡cios" },
+  { href: "/milon/programs", label: "Programas" },
+];
+
+// navItems espelham components/layout/PlutoLayout.tsx (D12 ÔÇö transversal)
+const plutoNavItems = [
+  { href: "/pluto/budget", label: "Or├ºamento Anual" },
+  { href: "/pluto/months", label: "Meses e Per├¡odos" },
+  { href: "/pluto/transactions", label: "Lan├ºamentos" },
+];
+
+function renderModuleLayout({
+  navItems,
+  pathname,
+  moduleName = "M├¡lon",
+  color = "#B7602B",
+}: {
+  navItems: { href: string; label: string }[];
+  pathname: string;
+  moduleName?: string;
+  color?: string;
+}) {
+  mockUsePathname.mockReturnValue(pathname);
+  return render(
+    <ModuleLayout
+      mascot="/mascots/test.png"
+      moduleName={moduleName}
+      color={color}
+      navItems={navItems}
+      pageTitle="T├¡tulo da p├ígina"
+    >
+      <div>Children</div>
+    </ModuleLayout>
+  );
+}
+
+function getNav(): HTMLElement {
+  return screen.getByRole("navigation");
+}
+
+/** Links da nav do m├│dulo com aria-current="page" (a "aba ativa"). */
+function activeLinks(): HTMLElement[] {
+  return within(getNav())
+    .queryAllByRole("link")
+    .filter((link) => link.getAttribute("aria-current") === "page");
+}
+
+/** R8 / AC "exatamente um link tem aria-current='page' em qualquer momento". */
+function expectExactlyOneActiveLink(): HTMLElement[] {
+  const active = activeLinks();
+  expect(active).toHaveLength(1);
+  return active;
+}
+
+describe("ModuleLayout ÔÇö aba ativa derivada da URL (TASK-015)", () => {
+  beforeEach(() => {
+    cleanup();
