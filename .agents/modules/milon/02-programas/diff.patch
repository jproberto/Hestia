+      (recorded.eqs ??= []).push([col, val]);
+      return chain;
+    },
+    maybeSingle: () => Promise.resolve({ data, error: null }),
+  };
+  return {
+    from: () => ({ select: () => chain }),
+  } as unknown as IDatabaseClient;
