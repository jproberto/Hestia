+import { render, screen, fireEvent } from "@testing-library/react";
+import { describe, it, expect, vi } from "vitest";
+import ProgramConfirmModal from "@/components/milon/ProgramConfirmModal";
+
+/**
+ * Contrato (plan.md ┬º3 "ProgramConfirmModal (props)" + TASK-009 acceptanceCriteria):
+ * - props: open, action ('ativar' | 'reativar' | 'excluir'), title, owner,
+ *   processing, onConfirm, onCancel.
+ * - R├│tulo do bot├úo de confirmar varia pela action: "Ativar" / "Reativar" / "Excluir".
+ * - processing mostra: "AtivandoÔÇª" / "ReativandoÔÇª" / "ExcluindoÔÇª".
+ * - Modal informa t├¡tulo e dono do programa alvo (spec ┬º3 "Confirma├º├úo em a├º├Áes").
+ * - Espelha o padr├úo de components/pluto/DeleteConfirmModal.tsx e
+ *   components/milon/DeleteExerciseConfirm.tsx (cancelar separado de confirmar,
+ *   bot├úo de confirmar desabilitado durante o processamento).
+ *
+ * Tipo de props declarado localmente: o contrato do plano n├úo exige export de
+ * tipo do componente ÔÇö o teste s├│ depende do default export.
+ */
+type Action = "ativar" | "reativar" | "excluir";
+
+interface ProgramConfirmModalProps {
+  open: boolean;
+  action: Action;
+  title: string;
+  owner: string;
+  processing: boolean;
+  onConfirm: () => void;
+  onCancel: () => void;
+}
+
+const ROTULOS: Record<Action, string> = {
+  ativar: "Ativar",
+  reativar: "Reativar",
+  excluir: "Excluir",
+};
+
+const TEXTOS_PROCESSING: Record<Action, string> = {
+  ativar: "AtivandoÔÇª",
+  reativar: "ReativandoÔÇª",
+  excluir: "ExcluindoÔÇª",
+};
+
+const ACOES = Object.keys(ROTULOS) as Action[];
+
+const TITULO = "Ficha Ver├úo 2026";
+const DONO = "ana@hestia.lan";
+
+function defaultProps(
+  overrides: Partial<ProgramConfirmModalProps> = {},
+): ProgramConfirmModalProps {
+  return {
+    open: true,
+    action: "ativar",
+    title: TITULO,
+    owner: DONO,
+    processing: false,
+    onConfirm: vi.fn(),
+    onCancel: vi.fn(),
+    ...overrides,
+  };
+}
+
+describe("ProgramConfirmModal", () => {
+  it("n├úo renderiza nada quando fechado", () => {
+    const { container } = render(
+      <ProgramConfirmModal {...defaultProps({ open: false })} />,
+    );
+    expect(container).toBeEmptyDOMElement();
+  });
+
+  describe("r├│tulo do bot├úo de confirmar por action (criterio 1)", () => {
+    it.each(ACOES)("action '%s' confirma com o r├│tulo correto", (action) => {
+      render(<ProgramConfirmModal {...defaultProps({ action })} />);
+
+      expect(
+        screen.getByRole("button", { name: ROTULOS[action] }),
+      ).toBeInTheDocument();
+      expect(screen.getByRole("button", { name: /cancelar/i })).toBeInTheDocument();
+    });
+  });
+
+  describe("estado processing (criterio 2)", () => {
+    it.each(ACOES)(
+      "action '%s' mostra o texto de processamento, desabilita e n├úo reconfirma",
+      (action) => {
+        const onConfirm = vi.fn();
