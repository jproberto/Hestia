+  });
+
+  describe("carga e escolha da unidade (D10 — toggle inline, sem prompt)", () => {
+    it("primeira carga digitada com loadUnit null commita direto (sem prompt âmbar)", () => {
+      const onSeriesCommit = vi.fn();
