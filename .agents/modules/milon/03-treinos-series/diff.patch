+): Promise<void> {
+  const entradas = await listEntriesByWorkout(db, workoutId);
+  if (entradas.length > 0) throw new Error(MSG_TREINO_COM_EXERCICIOS);
+
+  const { error } = await db
+    .from<WorkoutRow>("workouts")
+    .delete()
+    .eq("id", workoutId);
+  if (error) throw error;
+}
