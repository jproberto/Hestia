+          new MouseEvent("pointerdown", { bubbles: true, clientX: 20, clientY: 30 }),
+        );
+        fireEvent(
+          handle as Element,
+          new MouseEvent("pointermove", { bubbles: true, clientX: 20, clientY: 260 }),
