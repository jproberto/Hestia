+    expect(checkClause).toContain("'enviado'");
+    expect(checkClause).toContain("'cancelado'");
+    expect(checkClause).toContain("'erro'");
+    // sent_at TIMESTAMP WITH TIME ZONE anulável (sem NOT NULL)
