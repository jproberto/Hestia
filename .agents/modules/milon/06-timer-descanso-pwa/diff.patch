+
+      unmount();
+
+      expect(vi.getTimerCount()).toBe(0);
+      expect(() => vi.advanceTimersByTime(5000)).not.toThrow();
+      expect(vi.getTimerCount()).toBe(0);
+    });
+  });
+});
