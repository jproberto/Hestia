+const timerVazio: EstadoTimer = {
+  active: false,
+  remainingSeconds: null,
+  originWorkoutId: null,
+  exerciseName: null,
+  finished: false,
+};
+
+let timerInicial: EstadoTimer = { ...timerVazio };
