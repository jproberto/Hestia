+describe("Mílon #06 — rest-push-sender (contrato RED, TASK-007)", () => {
+  // -------------------------------------------------------------------------
+  // 1. getRestPushVapidDetails — env vars (DA8)
+  // -------------------------------------------------------------------------
+  describe("1. getRestPushVapidDetails", () => {
