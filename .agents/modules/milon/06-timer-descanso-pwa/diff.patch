+      duration_seconds: 90,
+      fire_at: FIRE_AT,
+      status: "agendado",
+      created_by: EMAIL,
+    });
+    expect(recorded.selects).toBeGreaterThan(0);
+    expect(schedule).toEqual(SCHED_ESPERADO);
