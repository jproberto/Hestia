+/** Estado inicial do timer em memória (sobrevive à troca — emenda 1). */
+interface EstadoTimer {
+  active: boolean;
+  remainingSeconds: number | null;
+  originWorkoutId: string | null;
+  exerciseName: string | null;
+  finished: boolean;
