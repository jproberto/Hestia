+const OUTRO_SUBSCRIPTION_ID = "0b2c4d6e-8f90-4a1b-8c2d-3e4f5a6b7c8d";
+const SCHEDULE_ID = "7c2d9b4e-5f60-4a71-9c82-1d2e3f4a5b6c";
