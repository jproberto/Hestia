+    expect(block).toMatch(/status\s+TEXT\s+NOT\s+NULL\s+DEFAULT\s+'agendado'/i);
+    // CHECK restrito aos quatro valores do plan §Migrações item 2
+    const checkIdx = block.search(/CHECK\s*\(/i);
