+// Tabelas existentes de execução/template que a 0017 NÃO pode alterar
+// (plan.md §"Migrações" parágrafo final + spec.md §3/§6).
+const EXISTING_TABLES = [
+  "workout_executions",
+  "workout_execution_series",
+  "workout_entries",
+  "workout_series",
+  "workouts",
+  "programs",
+  "exercises",
