diff --git a/lib/milon/repositories/push.ts b/lib/milon/repositories/push.ts
new file mode 100644
index 0000000..9e35e63
--- /dev/null
+++ b/lib/milon/repositories/push.ts
@@ -0,0 +1,232 @@
+// Acesso a dados de push do fim de descanso via IDatabaseClient (nunca do
+// pacote Supabase diretamente — o adapter vive só em lib/shared).
+// Regras de persistência vivem aqui (upsert por conflito no endpoint único da
+// 0017, agendamento com id gerado no cliente e status inicial agendado,
+// cancelamento filtrando dono + status — Mílon #06).
+// UI/rota consomem via lib/milon/db/push.
+import type { IDatabaseClient } from "@/lib/shared/database";
+import { createBrowserDatabaseClient } from "@/lib/shared/supabaseClient";
+import type {
+  CreateRestPushScheduleInput,
+  DevicePushSubscription,
+  PushSubscriptionRow,
+  RestPushSchedule,
+  RestPushScheduleRow,
+  RestPushScheduleStatus,
+  UpsertPushSubscriptionInput,
+} from "../types";
+
+function toSubscriptionDomain(row: PushSubscriptionRow): DevicePushSubscription {
+  return {
+    id: row.id,
+    endpoint: row.endpoint,
+    p256dh: row.p256dh,
+    auth: row.auth,
+    createdAt: row.created_at,
+    created_by: row.created_by,
+  };
+}
+
+function toScheduleDomain(row: RestPushScheduleRow): RestPushSchedule {
+  return {
+    id: row.id,
+    subscriptionId: row.subscription_id,
+    durationSeconds: row.duration_seconds,
+    fireAt: row.fire_at,
+    // A coluna é texto com CHECK dos quatro valores (migração 0017).
+    status: row.status as RestPushScheduleStatus,
+    sentAt: row.sent_at,
+    createdAt: row.created_at,
+    created_by: row.created_by,
+  };
+}
+
+// Upsert por conflito no endpoint: reinscrição do mesmo dispositivo atualiza
+// chaves e autoria ao dono da sessão corrente, sem trocar o id.
+export async function upsertSubscription(
+  db: IDatabaseClient,
+  input: UpsertPushSubscriptionInput,
+  email: string,
+): Promise<DevicePushSubscription> {
+  const { data, error } = await db
+    .from<PushSubscriptionRow>("push_subscriptions")
+    .upsert(
+      {
+        endpoint: input.endpoint,
+        p256dh: input.p256dh,
+        auth: input.auth,
+        created_by: email,
+      },
+      { onConflict: "endpoint" },
+    )
+    .select()
+    .single();
+
+  if (error) throw error;
+  if (!data)
+    throw new Error("Falha ao salvar assinatura de push: sem retorno do banco.");
+  return toSubscriptionDomain(data);
+}
+
+// Leitura da assinatura já gravada por endpoint (checagem de propriedade
+// antes do upsert — blocker B2 / DA2: uma sessão não pode reatribuir
+// created_by de linha alheia nem receber o push do descanso do outro dono).
+export async function findSubscriptionByEndpoint(
+  db: IDatabaseClient,
+  endpoint: string,
+): Promise<DevicePushSubscription | null> {
+  const { data, error } = await db
+    .from<PushSubscriptionRow>("push_subscriptions")
+    .select("*")
+    .eq("endpoint", endpoint)
+    .maybeSingle();
+
+  if (error) throw error;
+  return data ? toSubscriptionDomain(data) : null;
+}
+
+// INSERT com o id gerado no cliente (DA3: cancelável durante a espera da
+// rota) e status inicial agendado.
+export async function createRestSchedule(
+  db: IDatabaseClient,
+  input: CreateRestPushScheduleInput,
+  email: string,
+): Promise<RestPushSchedule> {
+  const { data, error } = await db
+    .from<RestPushScheduleRow>("rest_push_schedules")
+    .insert({
+      id: input.id,
+      subscription_id: input.subscriptionId,
+      duration_seconds: input.durationSeconds,
+      fire_at: input.fireAt,
+      status: "agendado",
+      created_by: email,
+    })
+    .select()
+    .single();
+
+  if (error) throw error;
+  if (!data)
+    throw new Error(
+      "Falha ao criar agendamento de push: sem retorno do banco.",
+    );
+  return toScheduleDomain(data);
+}
+
+export async function findRestScheduleById(
+  db: IDatabaseClient,
+  scheduleId: string,
+): Promise<RestPushSchedule | null> {
+  const { data, error } = await db
+    .from<RestPushScheduleRow>("rest_push_schedules")
+    .select("*")
+    .eq("id", scheduleId)
+    .maybeSingle();
+
+  if (error) throw error;
+  return data ? toScheduleDomain(data) : null;
+}
+
+// Cancelamento só do próprio dono e só enquanto agendado: linha alheia,
+// inexistente ou já terminal devolve false e nunca erro (guarda de dono na
+// aplicação, precedente das execuções).
+export async function cancelRestSchedule(
+  db: IDatabaseClient,
+  scheduleId: string,
+  email: string,
+): Promise<boolean> {
+  const { data, error } = await db
+    .from<RestPushScheduleRow>("rest_push_schedules")
+    .update({ status: "cancelado" })
+    .eq("id", scheduleId)
+    .eq("created_by", email)
+    .eq("status", "agendado")
+    .select();
+
+  if (error) throw error;
+  return (data ?? []).length > 0;
+}
+
+export async function markRestScheduleSent(
+  db: IDatabaseClient,
+  scheduleId: string,
+): Promise<void> {
+  const { error } = await db
+    .from<RestPushScheduleRow>("rest_push_schedules")
+    .update({ status: "enviado", sent_at: new Date().toISOString() })
+    .eq("id", scheduleId);
+
+  if (error) throw error;
+}
+
+export async function markRestScheduleFailed(
+  db: IDatabaseClient,
+  scheduleId: string,
+): Promise<void> {
+  const { error } = await db
+    .from<RestPushScheduleRow>("rest_push_schedules")
+    .update({ status: "erro" })
+    .eq("id", scheduleId);
+
+  if (error) throw error;
+}
+
+// Assinatura morta (o endpoint devolveu 404/410); os agendamentos dela caem
+// em cascata pela FK ON DELETE CASCADE da migração 0017.
+export async function deleteSubscriptionByEndpoint(
+  db: IDatabaseClient,
+  endpoint: string,
+): Promise<void> {
+  const { error } = await db
+    .from<PushSubscriptionRow>("push_subscriptions")
+    .delete()
+    .eq("endpoint", endpoint);
+
+  if (error) throw error;
+}
+
+// Standalones p/ consumers de browser (criam o próprio client, singleton por aba).
+export async function upsertSubscriptionStandalone(
+  input: UpsertPushSubscriptionInput,
+  email: string,
+): Promise<DevicePushSubscription> {
+  return upsertSubscription(createBrowserDatabaseClient(), input, email);
+}
+
+export async function createRestScheduleStandalone(
+  input: CreateRestPushScheduleInput,
+  email: string,
+): Promise<RestPushSchedule> {
+  return createRestSchedule(createBrowserDatabaseClient(), input, email);
+}
+
+export async function findRestScheduleByIdStandalone(
+  scheduleId: string,
+): Promise<RestPushSchedule | null> {
+  return findRestScheduleById(createBrowserDatabaseClient(), scheduleId);
+}
+
+export async function cancelRestScheduleStandalone(
+  scheduleId: string,
+  email: string,
+): Promise<boolean> {
+  return cancelRestSchedule(createBrowserDatabaseClient(), scheduleId, email);
+}
+
+export async function markRestScheduleSentStandalone(
+  scheduleId: string,
+): Promise<void> {
+  return markRestScheduleSent(createBrowserDatabaseClient(), scheduleId);
+}
+
+export async function markRestScheduleFailedStandalone(
+  scheduleId: string,
+): Promise<void> {
+  return markRestScheduleFailed(createBrowserDatabaseClient(), scheduleId);
+}
+
+export async function deleteSubscriptionByEndpointStandalone(
+  endpoint: string,
+): Promise<void> {
+  return deleteSubscriptionByEndpoint(createBrowserDatabaseClient(), endpoint);
+}
diff --git a/lib/milon/rest-push-client.ts b/lib/milon/rest-push-client.ts
new file mode 100644
index 0000000..febe03c
--- /dev/null
+++ b/lib/milon/rest-push-client.ts
@@ -0,0 +1,117 @@
+// Helpers de push do fim de descanso no cliente (Mílon #06, TASK-006):
+// ensureDeviceSubscription (assinatura do navegador sob permissão granted),
+// scheduleRestPush/cancelRestPush (POST na rota /api/milon/rest-push) e a
+// regra pura urlBase64ToUint8Array (chave pública VAPID base64url → bytes).
+// Push é melhor esforço: indisponibilidade vira null/silêncio e nunca
+// bloqueia a marcação (spec critério 10); agendamento/cancelamento são
+// sempre chamados fire-and-forget pelo useRestTimer.
+
+const ROTA_REST_PUSH = "/api/milon/rest-push";
+
+// Formato do payload de assinatura aceito pela rota (endpoint + chaves).
+export interface RestPushSubscriptionPayload {
+  endpoint: string;
+  keys: { p256dh: string; auth: string };
+}
+
+export interface ScheduleRestPushInput {
+  scheduleId: string;
+  subscription: RestPushSubscriptionPayload;
+  durationSeconds: number;
+  exerciseName?: string;
+}
+
+/**
+ * Converte chave pública VAPID em base64url para os bytes exigidos pelo
+ * PushManager (regra pura, teste direto).
+ */
+export function urlBase64ToUint8Array(base64: string): Uint8Array<ArrayBuffer> {
+  const padding = "=".repeat((4 - (base64.length % 4)) % 4);
+  const base64Normalizada = `${base64}${padding}`.replace(/-/g, "+").replace(/_/g, "/");
+  const rawData = atob(base64Normalizada);
+  const outputArray = new Uint8Array(rawData.length);
+  for (let i = 0; i < rawData.length; i += 1) {
+    outputArray[i] = rawData.charCodeAt(i);
+  }
+  return outputArray;
+}
+
+// O JSON do PushSubscription do navegador tem endpoint e chaves opcionais;
+// payload incompleto não serve para a rota — devolve null (indisponibilidade).
+function extrairPayload(
+  json: PushSubscriptionJSON,
+): RestPushSubscriptionPayload | null {
+  if (!json.endpoint || !json.keys?.p256dh || !json.keys?.auth) {
+    return null;
+  }
+  return {
+    endpoint: json.endpoint,
+    keys: { p256dh: json.keys.p256dh, auth: json.keys.auth },
+  };
+}
+
+async function postRestPush(corpo: Record<string, unknown>): Promise<void> {
+  const resposta = await fetch(ROTA_REST_PUSH, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(corpo),
+  });
+  if (!resposta.ok) {
+    throw new Error(`Agendamento de push recusado (${resposta.status}).`);
+  }
+}
+
+/**
+ * Devolve o JSON da assinatura de push do dispositivo (endpoint + keys) ou
+ * `null` quando push está indisponível (sem service worker, permissão não
+ * concedida, sem PushManager ou falha interna) — nunca lança.
+ */
+export async function ensureDeviceSubscription(): Promise<RestPushSubscriptionPayload | null> {
+  try {
+    if (typeof Notification === "undefined" || Notification.permission !== "granted") {
+      return null;
+    }
+    if (
+      typeof navigator === "undefined" ||
+      !navigator.serviceWorker ||
+      typeof PushManager === "undefined"
+    ) {
+      return null;
+    }
+    const registration = await navigator.serviceWorker.ready;
+    if (!registration?.pushManager) {
+      return null;
+    }
+    const existente = await registration.pushManager.getSubscription();
+    if (existente) {
+      return extrairPayload(existente.toJSON());
+    }
+    const chavePublica = process.env.NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY;
+    if (!chavePublica) {
+      return null;
+    }
+    const inscrita = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: urlBase64ToUint8Array(chavePublica),
+    });
+    return extrairPayload(inscrita.toJSON());
+  } catch {
+    return null;
+  }
+}
+
+/** Agenda o fim do descanso na rota; lança em resposta não-2xx. */
+export async function scheduleRestPush(input: ScheduleRestPushInput): Promise<void> {
+  await postRestPush({
+    action: "schedule",
+    scheduleId: input.scheduleId,
+    durationSeconds: input.durationSeconds,
+    exerciseName: input.exerciseName,
+    subscription: input.subscription,
+  });
+}
+
+/** Cancela agendamento na rota; lança em resposta não-2xx. */
+export async function cancelRestPush(scheduleId: string): Promise<void> {
+  await postRestPush({ action: "cancel", scheduleId });
+}
