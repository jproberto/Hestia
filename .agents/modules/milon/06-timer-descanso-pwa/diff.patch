+const P256DH = "p256dh-chave-do-dispositivo";
+const AUTH = "auth-segredo-do-dispositivo";
+
+const ASSINATURA: DevicePushSubscription = {
+  id: "3f1c8f9e-1a2b-4c5d-8e6f-0a1b2c3d4e5f",
+  endpoint: ENDPOINT,
+  p256dh: P256DH,
