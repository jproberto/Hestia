+import { describe, it, expect } from "vitest";
+import fs from "node:fs";
+import path from "node:path";
+
+// ---------------------------------------------------------------------------
+// Contrato da T0 (Pluto 05e, Lan├ºamento com Data Livre) ÔÇö teste de conte├║do
+// RED da migra├º├úo 0018, no padr├úo EXATO de
+// `__tests__/lib/milon/migration-0017.test.ts`.
+// Fontes: `plan.md` ┬º"Migra├º├Áes" (plan.md:94-110 ÔÇö n├║mero reservado 0018;
+// quatro passos ordenados: 1) ADD COLUMN IF NOT EXISTS period_year/period_month
+// integer ANUL├üVEIS em public.transactions; 2) backfill retroativo copiando
+// ano/m├¬s da pr├│pria `date` com CONVERS├âO EXPL├ìCITA para integer nas
+// atribui├º├Áes, WHERE period_year IS NULL OR period_month IS NULL; 3) SET NOT NULL
+// nas duas colunas SOMENTE ap├│s o backfill; 4) auditoria com self-bootstrap
+// idempotente de public.schema_migrations (CREATE TABLE IF NOT EXISTS + RLS +
+// pol├¡tica "Permitir tudo para autenticados", mesmo bloco das migra├º├Áes
+// 0008/0016) e INSERT com spec_id `pluto-05e`, spec_name `Lan├ºamento com Data
+// Livre`, script_name id├¬ntico ao nome do arquivo e executed_by
+// joaopsroberto@gmail.com, com ON CONFLICT (script_name) DO NOTHING;
+// "explicitamente n├úo faz": nenhuma remo├º├úo/renomea├º├úo de coluna ou tabela,
+// nenhuma pol├¡tica RLS nova em transactions, nenhum ├¡ndice novo; rollback em
+// texto no rodap├® (DROP COLUMN IF EXISTS das duas colunas); verifica├º├úo
+// p├│s-aplica├º├úo documentada em coment├írio no pr├│prio script ÔÇö contagem de
+// linhas com m├¬s de c├ílculo nulo = 0 e soma de amount agrupada por ano/m├¬s de
+// `date` antes/depois com diferen├ºa zero) + `tasks.json` T0
+// (acceptanceCriteria 1-10) + `spec.md` ┬º6 (migra├º├úo aditiva; auditoria com
+// nome id├¬ntico ao arquivo; verifica├º├úo de saldos por m├¬s).
+//
+// RED ESPERADO (Gate 3, antes de Hefesto/T1): o arquivo
+// utils/migrations/migration-0018-pluto-lancamento-data-livre.sql ├® produzido
+// apenas na T1 e ainda N├âO existe ÔÇö logo `readFileSync` lan├ºa ENOENT e TODOS
+// os casos falham pelo motivo certo (arquivo da migra├º├úo inexistente), sem
+// SyntaxError/TS2 no output. Nenhum arquivo de produ├º├úo ├® tocado por esta task.
+// ---------------------------------------------------------------------------
+
+const SCRIPT_NAME = "migration-0018-pluto-lancamento-data-livre.sql";
+
+function loadMigrationSql(): string {
+  const file = path.resolve(
+    __dirname,
+    "../../../utils/migrations",
+    SCRIPT_NAME,
+  );
+  return fs.readFileSync(file, "utf8");
+}
+
+/** Remove coment├írios de linha (`-- ...`) para as asser├º├Áes negativas n├úo trocarem em texto de rollback/header. */
+function stripSqlComments(sql: string): string {
+  return sql
+    .split(/\r?\n/)
+    .map((line) => line.replace(/--.*$/, ""))
+    .join("\n");
+}
+
+/** Extrai apenas o texto de coment├írios (linhas com `--`), para as consultas de verifica├º├úo em coment├írio. */
+function extractCommentLines(sql: string): string {
+  return sql
+    .split(/\r?\n/)
+    .filter((line) => line.includes("--"))
+    .join("\n");
+}
+
+/** Extrai um comando SQL a partir do match at├® o `;` seguinte (inclusive). */
+function extractStatement(sql: string, search: RegExp): string {
+  const start = sql.search(search);
+  if (start < 0) return "";
+  const end = sql.indexOf(";", start);
+  return end < 0 ? sql.slice(start) : sql.slice(start, end + 1);
+}
+
+describe("Pluto 05e T0 ÔÇö migra├º├úo 0018 (lan├ºamento com data livre, m├¬s de c├ílculo)", () => {
+  it("adiciona as colunas period_year e period_month inteiras e anul├íveis em public.transactions", () => {
+    const sql = loadMigrationSql();
+    const addYear = extractStatement(
+      sql,
+      /ALTER\s+TABLE\s+public\.transactions\s+ADD\s+COLUMN\s+IF\s+NOT\s+EXISTS\s+period_year/i,
+    );
+    const addMonth = extractStatement(
+      sql,
+      /ALTER\s+TABLE\s+public\.transactions\s+ADD\s+COLUMN\s+IF\s+NOT\s+EXISTS\s+period_month/i,
+    );
+    expect(addYear).not.toBe("");
+    expect(addMonth).not.toBe("");
+    expect(addYear).toMatch(/\binteger\b/i);
+    expect(addMonth).toMatch(/\binteger\b/i);
+    // Anul├íveis na cria├º├úo: o backfill precisa rodar antes de impor obrigatoriedade
+    expect(addYear).not.toMatch(/NOT\s+NULL/i);
+    expect(addMonth).not.toMatch(/NOT\s+NULL/i);
+  });
+
+  it("faz o backfill pela pr├│pria date com convers├úo expl├¡cita para integer, ANTES do SET NOT NULL", () => {
+    const sql = loadMigrationSql();
+    const backfill = extractStatement(
+      sql,
+      /UPDATE\s+public\.transactions\s+SET\s+period_year\s*=/i,
+    );
+    expect(backfill).not.toBe("");
+    // Copia ano/m├¬s da pr├│pria coluna date (decis├úo D8)
+    expect(backfill).toMatch(
+      /period_year\s*=\s*(?:EXTRACT\s*\(\s*YEAR\s+FROM\s+date\s*\)\s*::\s*(?:integer|int)\b|CAST\s*\(\s*EXTRACT\s*\(\s*YEAR\s+FROM\s+date\s*\)\s+AS\s+(?:integer|int)\s*\))/i,
+    );
+    expect(backfill).toMatch(
+      /period_month\s*=\s*(?:EXTRACT\s*\(\s*MONTH\s+FROM\s+date\s*\)\s*::\s*(?:integer|int)\b|CAST\s*\(\s*EXTRACT\s*\(\s*MONTH\s+FROM\s+date\s*\)\s+AS\s+(?:integer|int)\s*\))/i,
+    );
+    // S├│ nas linhas ainda sem per├¡odo calculado (idempotente)
+    expect(backfill).toMatch(
+      /WHERE\s+period_year\s+IS\s+NULL\s+OR\s+period_month\s+IS\s+NULL/i,
+    );
+    // Ordem: backfill ANTES da imposi├º├úo de obrigatoriedade (passos 2 ÔåÆ 3)
+    const backfillIdx = sql.search(
+      /UPDATE\s+public\.transactions\s+SET\s+period_year\s*=/i,
+    );
+    const notNullYearIdx = sql.search(
+      /ALTER\s+TABLE\s+public\.transactions\s+ALTER\s+COLUMN\s+period_year\s+SET\s+NOT\s+NULL/i,
+    );
+    const notNullMonthIdx = sql.search(
+      /ALTER\s+TABLE\s+public\.transactions\s+ALTER\s+COLUMN\s+period_month\s+SET\s+NOT\s+NULL/i,
+    );
+    expect(backfillIdx).toBeGreaterThanOrEqual(0);
+    expect(notNullYearIdx).toBeGreaterThan(backfillIdx);
+    expect(notNullMonthIdx).toBeGreaterThan(backfillIdx);
+  });
+
+  it("imp├Áe SET NOT NULL nas duas colunas somente ap├│s o backfill", () => {
+    const sql = loadMigrationSql();
+    const setNotNullYear = extractStatement(
+      sql,
